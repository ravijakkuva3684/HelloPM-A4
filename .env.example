# Remindly - Supabase Configuration
# Obtain these from your Supabase project dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Application URL for auth redirects (default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
